# ==============================================================================
# CAMPUS PULSE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit your real .env.local file or real API keys to version control.
# NEVER put real credentials in .env.example — this file IS committed to Git.
# ==============================================================================

# NEXT.JS APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# SUPABASE (HOSTED POSTGRESQL & AUTHENTICATION)
# Obtain these from: Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is strictly server-side. NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# GOOGLE GEMINI AI
# Server-side only. Never expose in browser. Never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# RATE LIMITING & SECURITY (OPTIONAL / PRODUCTION)
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_ANNOUNCEMENT_INPUT_LENGTH=10000
